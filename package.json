{
    "name": "selenium-mocha-digital-skola",
    "version": "1.0.0",
    "type": "module",
    "description": "Selenium WebDriver tests using Mocha with Mochawesome reports",
    "scripts": {
      "test": "mocha tests/test-sauce.js --recursive --timeout 60000",
      "test-parallel": "mocha tests --parallel --recursive --timeout 60000",
      "test-pertama": "mocha tests --grep 'Pertama' --recursive --timeout 60000",
      "test-mochawesome": "mocha tests/test-sauce.js --recursive --timeout 60000 --reporter mochawesome",
      "test-simple-html": "mocha tests/test-sauce.js --recursive --timeout 60000 --reporter mocha-simple-html-reporter --reporter-options output=report.html"
    },
    "dependencies": {
      "selenium-webdriver": "^4.17.0",
      "pngjs": "^7.0.0",
      "pixelmatch": "^7.1.0"
    },
    "devDependencies": {
      "mocha": "^10.4.0",
      "mochawesome": "^7.1.3",
      "mocha-simple-html-reporter": "^2.0.0"
    }
  }